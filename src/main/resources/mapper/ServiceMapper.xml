<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tpp.threat_perception_platform.dao.ServiceMapper">

    <resultMap id="BaseResultMap" type="com.tpp.threat_perception_platform.asset.Service">
            <id property="serviceId" column="service_id" />
            <result property="protocol" column="protocol" />
            <result property="port" column="port" />
            <result property="state" column="state" />
            <result property="name" column="name" />
            <result property="product" column="product" />
            <result property="version" column="version" />
            <result property="extrainfo" column="extrainfo" />
            <result property="hostName" column="host_name" />
            <result property="id" column="id" />
            <result property="macAddress" column="mac_address" />
            <result property="time" column="time" />
            <result property="detectId" column="detect_id" />
    </resultMap>

    <sql id="Base_Column_List">
        service_id,protocol,port,state,name,product,
        version,extrainfo,host_name,id,mac_address,
        time,detect_id
    </sql>

    <select id="selectByPrimaryKey" parameterType="java.lang.Long" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List" />
        from service
        where  service_id = #{serviceId} 
    </select>
    <select id="selectByNameAndHost" parameterType="map" resultType="com.tpp.threat_perception_platform.asset.Service">
    SELECT * FROM service WHERE name = #{name} AND host_name = #{hostName}
    </select>

    <select id="selectLastDetectIdByMac" parameterType="string" resultType="int">
    SELECT detect_id FROM service WHERE mac_address = #{macAddress}
    ORDER BY detect_id DESC LIMIT 1
    </select>
    <select id="selectAllByMacAddress" resultType="com.tpp.threat_perception_platform.asset.Service">
        select
            <include refid="Base_Column_List"/>
            from service
        where mac_address = #{macAddress}
    </select>
    <select id="selectByDetectId" resultType="com.tpp.threat_perception_platform.asset.Service">
        select <include refid="Base_Column_List"/>
            from service
        where detect_id=#{detectId}
    </select>

    <delete id="deleteByPrimaryKey" parameterType="java.lang.Long">
        delete from service
        where  service_id = #{serviceId} 
    </delete>
    <insert id="insert" keyColumn="service_id" keyProperty="serviceId" parameterType="com.tpp.threat_perception_platform.asset.Service" useGeneratedKeys="true">
        insert into service
        ( service_id,protocol,port,state,name,product,
        version,extrainfo,host_name,id,mac_address,
        time,detect_id)
        values (#{serviceId},#{protocol},#{port},#{state},#{name},#{product},
        #{version},#{extrainfo},#{hostName},#{id},#{macAddress},
        #{time},#{detectId})
    </insert>
    <insert id="insertSelective" keyColumn="service_id" keyProperty="serviceId" parameterType="com.tpp.threat_perception_platform.asset.Service" useGeneratedKeys="true">
        insert into service
        <trim prefix="(" suffix=")" suffixOverrides=",">
                <if test="serviceId != null">service_id,</if>
                <if test="protocol != null">protocol,</if>
                <if test="port != null">port,</if>
                <if test="state != null">state,</if>
                <if test="name != null">name,</if>
                <if test="product != null">product,</if>
                <if test="version != null">version,</if>
                <if test="extrainfo != null">extrainfo,</if>
                <if test="hostName != null">host_name,</if>
                <if test="id != null">id,</if>
                <if test="macAddress != null">mac_address,</if>
                <if test="time != null">time,</if>
                <if test="detectId != null">detect_id,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
                <if test="serviceId != null">#{serviceId},</if>
                <if test="protocol != null">#{protocol},</if>
                <if test="port != null">#{port},</if>
                <if test="state != null">#{state},</if>
                <if test="name != null">#{name},</if>
                <if test="product != null">#{product},</if>
                <if test="version != null">#{version},</if>
                <if test="extrainfo != null">#{extrainfo},</if>
                <if test="hostName != null">#{hostName},</if>
                <if test="id != null">#{id},</if>
                <if test="macAddress != null">#{macAddress},</if>
                <if test="time != null">#{time},</if>
                <if test="detectId != null">#{detectId},</if>
        </trim>
    </insert>
    <update id="updateByPrimaryKeySelective" parameterType="com.tpp.threat_perception_platform.asset.Service">
        update service
        <set>
                <if test="protocol != null">
                    protocol = #{protocol},
                </if>
                <if test="port != null">
                    port = #{port},
                </if>
                <if test="state != null">
                    state = #{state},
                </if>
                <if test="name != null">
                    name = #{name},
                </if>
                <if test="product != null">
                    product = #{product},
                </if>
                <if test="version != null">
                    version = #{version},
                </if>
                <if test="extrainfo != null">
                    extrainfo = #{extrainfo},
                </if>
                <if test="hostName != null">
                    host_name = #{hostName},
                </if>
                <if test="id != null">
                    id = #{id},
                </if>
                <if test="macAddress != null">
                    mac_address = #{macAddress},
                </if>
                <if test="time != null">
                    time = #{time},
                </if>
                <if test="detectId != null">
                    detect_id = #{detectId},
                </if>
        </set>
        where   service_id = #{serviceId} 
    </update>
    <update id="updateByPrimaryKey" parameterType="com.tpp.threat_perception_platform.asset.Service">
        update service
        set 
            protocol =  #{protocol},
            port =  #{port},
            state =  #{state},
            name =  #{name},
            product =  #{product},
            version =  #{version},
            extrainfo =  #{extrainfo},
            host_name =  #{hostName},
            id =  #{id},
            mac_address =  #{macAddress},
            time =  #{time},
            detect_id =  #{detectId}
        where   service_id = #{serviceId} 
    </update>
</mapper>
