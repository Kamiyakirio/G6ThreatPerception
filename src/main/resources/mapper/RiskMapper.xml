    <insert id="insert" keyColumn="id" keyProperty="id" parameterType="com.tpp.threat_perception_platform.pojo.Risk" useGeneratedKeys="true">
        insert into risk
        (id, re, risk_desc, risk_type)
        values
        (#{id}, #{re}, #{riskDesc}, #{riskType})
    </insert>

    <insert id="insertSelective" keyColumn="id" keyProperty="id" parameterType="com.tpp.threat_perception_platform.pojo.Risk" useGeneratedKeys="true">
        insert into risk
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="re != null">re,</if>
            <if test="riskDesc != null">risk_desc,</if>
            <if test="riskType != null">risk_type,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="re != null">#{re},</if>
            <if test="riskDesc != null">#{riskDesc},</if>
            <if test="riskType != null">#{riskType},</if>
        </trim>
    </insert>

    <update id="updateByPrimaryKeySelective" parameterType="com.tpp.threat_perception_platform.pojo.Risk">
        update risk
        <set>
            <if test="re != null">
                re = #{re},
            </if>
            <if test="riskDesc != null">
                risk_desc = #{riskDesc},
            </if>
            <if test="riskType != null">
                risk_type = #{riskType},
            </if>
        </set>
        where id = #{id}
    </update>

    <update id="updateByPrimaryKey" parameterType="com.tpp.threat_perception_platform.pojo.Risk">
        update risk
        set
            re = #{re},
            risk_desc = #{riskDesc},
            risk_type = #{riskType}
        where id = #{id}
    </update>

</mapper>
