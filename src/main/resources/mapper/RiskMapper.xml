<mapper namespace="com.tpp.threat_perception_platform.dao.RiskMapper">

    <resultMap id="BaseResultMap" type="com.tpp.threat_perception_platform.pojo.Risk">
        <id property="id" column="id"/>
        <result property="re" column="re"/>
        <result property="riskDesc" column="risk_desc"/>
        <result property="riskType" column="risk_type"/>
